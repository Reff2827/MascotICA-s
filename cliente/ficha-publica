<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Ficha pública · MascotICA's</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet">

    <link rel="stylesheet" href="../css/styles.css">

    <script src="../js/theme.js"></script>
</head>

<body>

<div id="navbar"></div>

<div class="container-fluid px-4 pb-5">

    <div class="text-center mb-4">
        <h2 class="fw-bold mb-1">MascotICA's</h2>

        <h3 class="fw-bold">
            FICHA PÚBLICA DE ADOPCIÓN
        </h3>

        <p class="text-muted">
            Registro público de una adopción realizada en MascotICA's
        </p>
    </div>


    <div
        class="card border-0 shadow-sm mx-auto"
        style="max-width:850px;">

        <div class="card-body p-4">

            <div
                id="cargando"
                class="text-center py-5">

                <div
                    class="spinner-border text-primary"
                    role="status">
                </div>

                <p class="text-muted mt-3">
                    Cargando ficha...
                </p>

            </div>


            <div
                id="ficha"
                class="d-none">

                <div class="row g-4 align-items-center">

                    <div class="col-md-5 text-center">

                        <img
                            id="fotoMascota"
                            src=""
                            alt="Mascota adoptada"
                            class="img-fluid rounded shadow-sm"
                            style="max-height:320px; width:100%; object-fit:cover;">

                    </div>


                    <div class="col-md-7">

                        <h2
                            id="nombreMascota"
                            class="fw-bold mb-3">
                        </h2>

                        <div class="mb-2">
                            <strong>Especie:</strong>
                            <span id="especieMascota"></span>
                        </div>

                        <div class="mb-2">
                            <strong>Raza / tipo:</strong>
                            <span id="razaMascota"></span>
                        </div>

                        <div class="mb-2">
                            <strong>Edad:</strong>
                            <span id="edadMascota"></span>
                        </div>

                        <div class="mb-3">
                            <strong>Sexo:</strong>
                            <span id="sexoMascota"></span>
                        </div>

                        <hr>

                        <div class="mb-2">
                            <strong>ID de adopción:</strong>
                            <span
                                id="codigoFicha"
                                class="badge bg-primary">
                            </span>
                        </div>

                        <div>
                            <strong>Fecha de adopción:</strong>
                            <span id="fechaAdopcion"></span>
                        </div>

                    </div>

                </div>

            </div>


            <div
                id="sinFicha"
                class="d-none text-center py-5">

                <i class="bi bi-file-earmark-x fs-1 text-muted"></i>

                <h5 class="fw-bold mt-3">
                    Ficha no encontrada
                </h5>

                <p class="text-muted">
                    El código indicado no corresponde a una ficha pública.
                </p>

            </div>

        </div>

    </div>

</div>


<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="../js/supabaseClient.js"></script>
<script src="../js/storage.js"></script>
<script src="../js/auth.js"></script>
<script src="../js/ui.js"></script>

<script>

const usuario =
    typeof Auth !== 'undefined'
        ? Auth.usuarioActual()
        : null;


if (usuario) {
    UI.navbarCliente(usuario);
}


cargarFichaPublica();


async function cargarFichaPublica() {

    const codigo =
        new URLSearchParams(window.location.search)
            .get('id');

    if (!codigo) {
        mostrarSinFicha();
        return;
    }

    const { data, error } = await db.rpc(
        'obtener_ficha_publica',
        {
            p_codigo: codigo
        }
    );

    if (
        error ||
        !data ||
        data.length === 0
    ) {
        mostrarSinFicha();
        return;
    }

    const ficha = data[0];

    document.getElementById('nombreMascota').textContent =
        ficha.nombre_mascota;

    document.getElementById('especieMascota').textContent =
        ficha.especie;

    document.getElementById('razaMascota').textContent =
        ficha.raza || 'No especificado';

    document.getElementById('edadMascota').textContent =
        ficha.edad;

    document.getElementById('sexoMascota').textContent =
        ficha.sexo || 'No registrado';

    document.getElementById('codigoFicha').textContent =
        ficha.codigo;

    document.getElementById('fechaAdopcion').textContent =
        new Date(
            ficha.fecha_adopcion
        ).toLocaleDateString('es-PE');

    document.getElementById('fotoMascota').src =
        UI.imagenOPlaceholder(
            ficha.imagen_url,
            ficha.nombre_mascota
        );

    document.getElementById('cargando')
        .classList.add('d-none');

    document.getElementById('ficha')
        .classList.remove('d-none');
}


function mostrarSinFicha() {

    document.getElementById('cargando')
        .classList.add('d-none');

    document.getElementById('sinFicha')
        .classList.remove('d-none');

}

</script>

</body>
</html>